<span class="status-item lofi-player">
  <button id="lofi-toggle" class="icon-button lofi-toggle" type="button" data-state="paused" aria-pressed="false" aria-label="Play lofi radio" title="Play lofi radio">
    <svg class="lofi-icon lofi-icon-play" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 0.5 9 5 1 9.5Z" fill="currentColor" /></svg>
    <svg class="lofi-icon lofi-icon-pause" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 0.5h3v9H1zM6 0.5h3v9H6z" fill="currentColor" /></svg>
    <svg class="lofi-icon lofi-icon-buffer" viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 2" /></svg>
  </button>
  <input id="lofi-volume" class="lofi-volume" type="range" min="0" max="1" step="0.01" value="0.7" aria-label="Lofi radio volume" />
  <audio id="lofi-audio" src="https://ice1.somafm.com/groovesalad-128-mp3" preload="none"></audio>
</span>
<script>
  import '../scripts/lofi.js';
</script>
